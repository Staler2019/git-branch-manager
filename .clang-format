---
Language: Cpp
BasedOnStyle: Google
Standard: c++20
ColumnLimit: 100
IndentWidth: 4
AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: false
BinPackParameters: false
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"gbm/'
    Priority: 1
  - Regex: '^<Q'
    Priority: 3
  - Regex: '^<'
    Priority: 4
  - Regex: '.*'
    Priority: 2
# Not Always: v18 then reports a replacement with identical text at the catch of every
# function-try-block, so `--dry-run --Werror` is red on a file `-i` leaves unchanged.
SeparateDefinitionBlocks: Leave
