{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "core-only",
      "inherits": "base",
      "displayName": "Core + tests",
      "cacheVariables": { "GBM_BUILD_TESTS": "ON" }
    },
    {
      "name": "capi-only",
      "inherits": "base",
      "displayName": "Core + capi (FFI) + tests",
      "cacheVariables": {
        "GBM_BUILD_CAPI": "ON",
        "GBM_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "inherits": "base",
      "displayName": "Core with address+undefined sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GBM_BUILD_TESTS": "ON",
        "GBM_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "Core with thread sanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GBM_BUILD_TESTS": "ON",
        "GBM_SANITIZE": "thread"
      }
    }
  ],
  "buildPresets": [
    { "name": "core-only", "configurePreset": "core-only" },
    { "name": "capi-only", "configurePreset": "capi-only" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "tsan", "configurePreset": "tsan" }
  ],
  "testPresets": [
    {
      "name": "tbase",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "core-only",
      "inherits": "tbase",
      "configurePreset": "core-only",
      "filter": { "exclude": { "label": "perf" } }
    },
    {
      "name": "capi-only",
      "inherits": "tbase",
      "configurePreset": "capi-only",
      "filter": { "exclude": { "label": "perf" } }
    },
    {
      "name": "perf",
      "inherits": "tbase",
      "configurePreset": "core-only",
      "filter": { "include": { "label": "perf" } },
      "output": { "outputOnFailure": true, "verbosity": "verbose" }
    },
    {
      "name": "asan-ubsan",
      "inherits": "tbase",
      "configurePreset": "asan-ubsan",
      "filter": { "include": { "label": "unit|golden" } }
    },
    {
      "name": "tsan",
      "inherits": "tbase",
      "configurePreset": "tsan",
      "filter": { "include": { "label": "unit" } }
    }
  ],
  "workflowPresets": [
    {
      "name": "core-only",
      "steps": [
        { "type": "configure", "name": "core-only" },
        { "type": "build", "name": "core-only" },
        { "type": "test", "name": "core-only" }
      ]
    },
    {
      "name": "capi-only",
      "steps": [
        { "type": "configure", "name": "capi-only" },
        { "type": "build", "name": "capi-only" },
        { "type": "test", "name": "capi-only" }
      ]
    },
    {
      "name": "perf",
      "steps": [
        { "type": "configure", "name": "core-only" },
        { "type": "build", "name": "core-only" },
        { "type": "test", "name": "perf" }
      ]
    },
    {
      "name": "asan-ubsan",
      "steps": [
        { "type": "configure", "name": "asan-ubsan" },
        { "type": "build", "name": "asan-ubsan" },
        { "type": "test", "name": "asan-ubsan" }
      ]
    },
    {
      "name": "tsan",
      "steps": [
        { "type": "configure", "name": "tsan" },
        { "type": "build", "name": "tsan" },
        { "type": "test", "name": "tsan" }
      ]
    }
  ]
}
