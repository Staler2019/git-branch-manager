{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Developer build (app + tests)",
      "cacheVariables": { "GBM_BUILD_APP": "ON", "GBM_BUILD_TESTS": "ON" }
    },
    {
      "name": "core-only",
      "inherits": "base",
      "displayName": "Core + tests, no Qt required",
      "cacheVariables": { "GBM_BUILD_APP": "OFF", "GBM_BUILD_TESTS": "ON" }
    },
    {
      "name": "asan-ubsan",
      "inherits": "base",
      "displayName": "Core with address+undefined sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GBM_BUILD_APP": "OFF",
        "GBM_BUILD_TESTS": "ON",
        "GBM_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "Core with thread sanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GBM_BUILD_APP": "OFF",
        "GBM_BUILD_TESTS": "ON",
        "GBM_SANITIZE": "thread"
      }
    },
    { "name": "ci-linux", "inherits": "dev", "displayName": "CI Linux" },
    { "name": "ci-macos", "inherits": "dev", "displayName": "CI macOS" },
    {
      "name": "ci-windows",
      "inherits": "dev",
      "displayName": "CI Windows",
      "cacheVariables": { "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "core-only", "configurePreset": "core-only" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "ci-linux", "configurePreset": "ci-linux" },
    { "name": "ci-macos", "configurePreset": "ci-macos" },
    { "name": "ci-windows", "configurePreset": "ci-windows" }
  ],
  "testPresets": [
    {
      "name": "tbase",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "dev", "inherits": "tbase", "configurePreset": "dev" },
    { "name": "core-only", "inherits": "tbase", "configurePreset": "core-only" },
    {
      "name": "asan-ubsan",
      "inherits": "tbase",
      "configurePreset": "asan-ubsan",
      "filter": { "include": { "label": "unit|golden" } }
    },
    {
      "name": "tsan",
      "inherits": "tbase",
      "configurePreset": "tsan",
      "filter": { "include": { "label": "unit" } }
    },
    {
      "name": "ci-linux",
      "inherits": "tbase",
      "configurePreset": "ci-linux",
      "filter": { "include": { "label": "unit|golden|integration" } }
    },
    {
      "name": "ci-macos",
      "inherits": "tbase",
      "configurePreset": "ci-macos",
      "filter": { "include": { "label": "unit|golden|integration" } }
    },
    {
      "name": "ci-windows",
      "inherits": "tbase",
      "configurePreset": "ci-windows",
      "filter": { "include": { "label": "unit|golden|integration" } }
    }
  ],
  "packagePresets": [
    { "name": "ci-linux", "configurePreset": "ci-linux", "generators": ["TGZ"] },
    { "name": "ci-macos", "configurePreset": "ci-macos", "generators": ["DragNDrop"] },
    { "name": "ci-windows", "configurePreset": "ci-windows", "generators": ["ZIP", "NSIS"] }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "core-only",
      "steps": [
        { "type": "configure", "name": "core-only" },
        { "type": "build", "name": "core-only" },
        { "type": "test", "name": "core-only" }
      ]
    },
    {
      "name": "asan-ubsan",
      "steps": [
        { "type": "configure", "name": "asan-ubsan" },
        { "type": "build", "name": "asan-ubsan" },
        { "type": "test", "name": "asan-ubsan" }
      ]
    },
    {
      "name": "tsan",
      "steps": [
        { "type": "configure", "name": "tsan" },
        { "type": "build", "name": "tsan" },
        { "type": "test", "name": "tsan" }
      ]
    },
    {
      "name": "ci-linux",
      "steps": [
        { "type": "configure", "name": "ci-linux" },
        { "type": "build", "name": "ci-linux" },
        { "type": "test", "name": "ci-linux" },
        { "type": "package", "name": "ci-linux" }
      ]
    },
    {
      "name": "ci-macos",
      "steps": [
        { "type": "configure", "name": "ci-macos" },
        { "type": "build", "name": "ci-macos" },
        { "type": "test", "name": "ci-macos" },
        { "type": "package", "name": "ci-macos" }
      ]
    },
    {
      "name": "ci-windows",
      "steps": [
        { "type": "configure", "name": "ci-windows" },
        { "type": "build", "name": "ci-windows" },
        { "type": "test", "name": "ci-windows" },
        { "type": "package", "name": "ci-windows" }
      ]
    }
  ]
}
