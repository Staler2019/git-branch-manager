<RCC>
    <qresource prefix="/">
        <file alias="qss/app.qss">qss/app.qss</file>
        <file alias="fonts/Inter-Regular.ttf">fonts/Inter-Regular.ttf</file>
        <file alias="fonts/Inter-Medium.ttf">fonts/Inter-Medium.ttf</file>
        <file alias="fonts/Inter-SemiBold.ttf">fonts/Inter-SemiBold.ttf</file>
        <file alias="fonts/Inter-Bold.ttf">fonts/Inter-Bold.ttf</file>
        <file alias="fonts/JetBrainsMono-Regular.ttf">fonts/JetBrainsMono-Regular.ttf</file>
        <file alias="fonts/JetBrainsMono-Medium.ttf">fonts/JetBrainsMono-Medium.ttf</file>
        <file alias="icons/git-branch.svg">icons/git-branch.svg</file>
        <file alias="icons/git-fork.svg">icons/git-fork.svg</file>
        <file alias="icons/cloud.svg">icons/cloud.svg</file>
        <file alias="icons/tag.svg">icons/tag.svg</file>
        <file alias="icons/archive.svg">icons/archive.svg</file>
        <file alias="icons/search.svg">icons/search.svg</file>
        <file alias="icons/cloud-download.svg">icons/cloud-download.svg</file>
        <file alias="icons/arrow-down.svg">icons/arrow-down.svg</file>
        <file alias="icons/arrow-up.svg">icons/arrow-up.svg</file>
        <file alias="icons/refresh-cw.svg">icons/refresh-cw.svg</file>
        <file alias="icons/palette.svg">icons/palette.svg</file>
        <file alias="icons/file.svg">icons/file.svg</file>
        <file alias="icons/alert-triangle.svg">icons/alert-triangle.svg</file>
        <file alias="icons/check.svg">icons/check.svg</file>
        <file alias="icons/chevron-right.svg">icons/chevron-right.svg</file>
        <file alias="icons/LUCIDE-ISC.txt">icons/LUCIDE-ISC.txt</file>
        <file alias="fonts/Inter-OFL.txt">fonts/Inter-OFL.txt</file>
        <file alias="fonts/JetBrainsMono-OFL.txt">fonts/JetBrainsMono-OFL.txt</file>
        <file alias="branding/app-icon-256.png">branding/app-icon-256.png</file>
        <file alias="branding/app-icon-512.png">branding/app-icon-512.png</file>
        <file alias="branding/app-icon-1024.png">branding/app-icon-1024.png</file>
    </qresource>
</RCC>
