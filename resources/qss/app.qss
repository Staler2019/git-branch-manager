/*
 * Theme stylesheet template.
 *
 * Placeholder convention: every colour is written with a leading "at" sign
 * followed by the design's CSS custom-property name from
 * docs/design/tokens-reference.md (colors.css), with its leading double
 * hyphen dropped -- for example the property that reads "surface-panel" in
 * colors.css appears below as that same name with an "at" sign in front.
 * `ThemeManager::applyTokensToQss()` substitutes every one of those
 * placeholders with the current theme's hex colour before this is pushed via
 * `qApp->setStyleSheet()`. No literal hex colour belongs in this file --
 * anything that needs a colour gets a placeholder, and one missing from the
 * table in ThemeManager.cpp's placeholderTable() would survive substitution
 * unresolved (caught by ThemeTest).
 *
 * Numeric spacing/radius values are written directly as pixels, mirroring
 * src/app/theme/Metrics.h, since QSS cannot reference C++ constants:
 *   radius-sm 4  radius-md 6  radius-lg 10  radius-full 999
 *   space-1 4  space-2 8  space-3 12  space-4 16
 */

QMainWindow {
    background: @surface-app;
}

QWidget {
    color: @text-primary;
    selection-background-color: @accent;
    selection-color: @text-on-accent;
}

/* --- menu bar / menus ---------------------------------------------------- */

QMenuBar {
    background: @surface-panel;
    color: @text-primary;
    border-bottom: 1px solid @border-subtle;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: @surface-hover;
}

QMenuBar::item:pressed {
    background: @accent-subtle;
    color: @accent;
}

QMenu {
    background: @surface-overlay;
    color: @text-primary;
    border: 1px solid @border-default;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 10px;
    border-radius: 4px;
    color: @text-primary;
}

QMenu::item:selected {
    background: @accent;
    color: @text-on-accent;
}

QMenu::item:disabled {
    color: @text-tertiary;
}

QMenu::separator {
    height: 1px;
    background: @border-subtle;
    margin: 4px 6px;
}

/* --- title bar --------------------------------------------------------------*/

/* The in-window row containing the app icon, app name, and the (now
 * non-native, see MainWindow::buildMenus) QMenuBar itself -- matches
 * Design.pdf's single dark title row rather than leaving File/Edit/… to
 * float on QMenuBar's own @surface-panel background with no container. */
QWidget#gbmTitleBar {
    background: @surface-sunken;
    border-bottom: 1px solid @border-subtle;
}

/* Inside #gbmTitleBar, so the menu bar reads as part of the row rather than
 * a second banded surface sitting on top of it. */
QWidget#gbmTitleBar QMenuBar {
    background: transparent;
    border-bottom: none;
}

/* --- toolbar --------------------------------------------------------------*/

QToolBar {
    background: @surface-panel;
    border-bottom: 1px solid @border-subtle;
    padding: 4px 8px;
    spacing: 8px;
}

QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
    color: @text-secondary;
}

QToolBar QToolButton:hover {
    background: @surface-hover;
    color: @text-primary;
}

QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
    background: @accent-subtle;
    color: @accent;
}

QToolBar::separator {
    background: @border-subtle;
    width: 1px;
    margin: 6px 4px;
}

QLabel#gbmRepoNameLabel {
    font-size: 18px;
    font-weight: 600;
}

QLabel#gbmRepoBranchLabel {
    color: @text-secondary;
}

/* The read-only Clean/Conflict state indicator (MainWindow::buildMenus).
 * Disabled QToolButtons so QSS's :checked state still applies -- Fusion
 * dims disabled widgets via QPalette::Disabled, which these two explicitly
 * override back to full colour, since "read-only" is not "unavailable". */
QWidget#gbmSegmented {
    background: @surface-sunken;
    border-radius: 8px;
    padding: 2px;
}

QWidget#gbmSegmented QToolButton {
    border-radius: 6px;
    padding: 4px 12px;
    color: @text-secondary;
    background: transparent;
}

QWidget#gbmSegmented QToolButton:disabled {
    color: @text-secondary;
}

QWidget#gbmSegmented QToolButton:checked {
    background: @accent;
    color: @text-on-accent;
}

QWidget#gbmSegmented QToolButton:checked:disabled {
    color: @text-on-accent;
}

/* --- conflict banner --------------------------------------------------------*/

/* `.gbm-banner-warning` in components.css. Previously a hand-rolled
 * setStyleSheet() call in MainWindow::restyleBanner(), re-applied manually
 * on every theme switch; objectName + qApp->setStyleSheet() now does that
 * automatically like everything else. */
QWidget#gbmBanner {
    background: @diff-del-bg;
    border-bottom: 1px solid @border-subtle;
}

QLabel#gbmBannerLabel {
    color: @diff-del-text;
}

/* --- buttons --------------------------------------------------------------*/

QPushButton {
    background: @surface-panel-raised;
    color: @text-primary;
    border: 1px solid @border-default;
    border-radius: 6px;
    padding: 0 12px;
    min-height: 30px;
}

QPushButton:hover {
    background: @surface-hover;
}

QPushButton:pressed {
    background: @surface-selected;
}

QPushButton:disabled {
    color: @text-tertiary;
    border-color: @border-subtle;
}

/* Primary / secondary / danger variants, selected by objectName -- the
 * later phases that add real buttons should set
 * `button->setObjectName("primaryButton")` (etc.) rather than styling ad hoc,
 * so every button in the app draws from these three states. */
QPushButton#primaryButton {
    background: @accent;
    color: @text-on-accent;
    border-color: @accent;
}

QPushButton#primaryButton:hover {
    background: @accent-hover;
}

QPushButton#primaryButton:pressed {
    background: @accent-active;
}

QPushButton#secondaryButton {
    background: @surface-panel-raised;
    color: @text-primary;
    border-color: @border-default;
}

QPushButton#secondaryButton:hover {
    background: @surface-hover;
}

QPushButton#dangerButton {
    background: transparent;
    color: @danger;
    border-color: @border-default;
}

QPushButton#dangerButton:hover {
    background: @diff-del-bg;
    border-color: @danger;
}

/* --- inputs ---------------------------------------------------------------*/

QLineEdit,
QPlainTextEdit,
QTextEdit {
    background: @surface-panel;
    color: @text-primary;
    border: 1px solid @border-default;
    border-radius: 6px;
    padding: 0 12px;
    min-height: 30px;
    selection-background-color: @accent;
    selection-color: @text-on-accent;
}

/* `.gbm-input:focus` also specifies `box-shadow: var(--shadow-focus)` -- a
 * 3px accent-subtle glow QSS cannot express. Approximated with a 2px solid
 * border-focus outline instead of the 1px default. */
QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border: 2px solid @border-focus;
}

QLineEdit:disabled {
    color: @text-tertiary;
    background: @surface-sunken;
}

/* --- checkboxes -------------------------------------------------------------*/

/* `.gbm-checkbox` in components.css: 15x15, radius 3, 1.5px border-strong,
 * filled @accent when checked/indeterminate. */
QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 3px;
    border: 1.5px solid @border-strong;
    background: @surface-panel;
}

QCheckBox::indicator:hover {
    border-color: @accent;
}

QCheckBox::indicator:checked,
QCheckBox::indicator:indeterminate {
    background: @accent;
    border-color: @accent;
}

QCheckBox::indicator:disabled {
    border-color: @border-subtle;
    background: @surface-sunken;
}

QCheckBox {
    spacing: 8px;
}

/* --- sidebar --------------------------------------------------------------*/

/* Section header labels ("REPOSITORIES" / "BRANCHES" / ...) above each of the
 * sidebar's five sections. text-2xs in tokens-reference.md is 10.5px; QSS
 * font-size does not reliably accept a fractional pixel value across styles,
 * so this rounds to 11px, matching the same rounding SidebarPanel/
 * RefRowDelegate use for the same token in hand-painted code. */
QLabel#sidebarSectionHeader {
    color: @text-tertiary;
    font-size: 11px;
    font-weight: 600;
    padding: 8px 12px 4px 12px;
}

/* --- bordered panels --------------------------------------------------------*/

/* A generic bordered/rounded container -- same border+radius recipe as
 * `QTabWidget::pane` above, reused rather than invented a second time. First
 * consumer: the Working Copy tab's Unstaged/Staged panels (`#workingCopyFilePanel`).
 * `#gbmPanel` is the same rule under a repo-content-neutral name for later
 * consumers that are not file panels -- Repository Settings' three cards and
 * Preferences' three sections (Phase 6). */
QFrame#workingCopyFilePanel,
QFrame#gbmPanel {
    background: @surface-panel;
    border: 1px solid @border-subtle;
    border-radius: 10px;
}

QLabel#workingCopyPanelHeader,
QLabel#gbmPanelHeader {
    font-weight: 600;
    padding: 6px 2px;
}

/* DiffPage's per-file section headers (item 12): same card/header recipe as
 * `#gbmPanel`/`#gbmPanelHeader` above, but the header is a plain QWidget (not
 * a QLabel) because it is clickable -- see DiffPage.cpp's ClickableHeader. */
QWidget#gbmPanelHeader {
    font-weight: 600;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}
QWidget#gbmPanelHeader:hover {
    background: @surface-hover;
}

QLabel#workingCopyPlaceholder {
    color: @text-tertiary;
}

QLabel#gbmPanelCaption {
    color: @text-tertiary;
    font-size: 11px;
}

/* --- commit expansion panel -------------------------------------------------*/

/* The card CommitExpansionPanel shows beneath the (hand-painted, not QSS)
 * summary strip when a commit row is expanded in place. Sunken rather than
 * `#gbmPanel`'s @surface-panel, so it reads as inset into the selected row
 * above it instead of as a separate raised surface. */
QWidget#gbmExpansionCard {
    background: @surface-sunken;
    border-radius: 10px;
}

QLabel#gbmExpansionSummary {
    color: @text-secondary;
}

/* `.gbm-badge` in components.css: min-width 18, height 18, padding 0 5,
 * radius-full, 10.5px semibold mono -- rounded to 11px, matching every other
 * `text-2xs` consumer in this file (see the sidebar section header comment). */
QLabel#gbmBadgeAdded,
QLabel#gbmBadgeRemoved {
    min-width: 18px;
    min-height: 18px;
    max-height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#gbmBadgeAdded {
    background: @diff-add-bg;
    color: @diff-add-text;
}

QLabel#gbmBadgeRemoved {
    background: @diff-del-bg;
    color: @diff-del-text;
}

/* --- scroll areas -------------------------------------------------------- */

/* DiffPage and CommitExpansionPanel both set QFrame::NoFrame in code, which
 * only drops the border -- the Fusion style still fills QScrollArea and its
 * internal viewport with QPalette::Base, a plain default gray with no
 * theme token behind it, which read as a seam against the panel surfaces
 * around it. The viewport has no stable object name to select directly, so
 * this targets it structurally: the immediate-child QWidget QScrollArea
 * creates to host setWidget()'s content. */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget {
    background: transparent;
}

/* --- tree / table views -----------------------------------------------------*/

QTreeView,
QTableView {
    background: @surface-panel;
    alternate-background-color: @surface-sunken;
    color: @text-primary;
    border: 1px solid @border-subtle;
    gridline-color: @border-subtle;
    selection-background-color: @surface-selected;
    selection-color: @text-primary;
    outline: none;
}

/* Row padding/hover/selected below is shared with QListView/QListWidget so
 * that plain item lists (the working-copy Unstaged/Staged panels, the
 * changed-files list) read as the same row height and hover treatment as
 * the tree/table views -- without also pulling in the tree/table's boxed
 * background and border, which several QListView/QListWidget usages (the
 * sidebar repo list, the stash list) are deliberately meant to sit flush
 * without. */
QTreeView::item,
QTableView::item,
QListView::item,
QListWidget::item {
    padding: 0 12px;
    border-radius: 4px;
}

QTreeView::item:hover,
QTableView::item:hover,
QListView::item:hover,
QListWidget::item:hover {
    background: @surface-hover;
}

/* Commit history and the ref tree/repo list paint their own selected-state
 * background at the delegate level (CommitRowDelegate/GraphColumnDelegate
 * full-bleed @surface-selected; RefRowDelegate/the sidebar repo delegate
 * paint an inset rounded highlight instead of full-bleed) -- scoped selectors
 * so this generic rule only covers plain views with no custom delegate
 * (the changed-files list, working-copy panels, dialog tables) instead of
 * fighting the hand-painted ones. */
QTreeView::item:selected,
QTableView::item:selected,
QListView::item:selected,
QListWidget::item:selected {
    background: @surface-selected;
    color: @text-primary;
}

QTableView#gbmCommitView::item:selected {
    background: transparent;
}

/* gbmRefView, gbmRepoList and gbmStashList's delegates all paint their own
 * inset selection/hover fill, so the generic rule above would double-draw
 * (harmless, but redundant) without these overrides. */
QTreeView#gbmRefView::item:selected,
QListView#gbmRepoList::item:selected,
QListWidget#gbmStashList::item:selected {
    background: transparent;
}

QHeaderView::section {
    background: @surface-panel-raised;
    color: @text-secondary;
    border: none;
    border-bottom: 1px solid @border-default;
    border-right: 1px solid @border-subtle;
    padding: 4px 8px;
}

/* The square left over where a vertical and horizontal scrollbar meet, e.g.
 * gbmCommitView/gbmRefView/gbmRepoView once history or the ref tree grows
 * wide enough to scroll sideways -- otherwise a default gray square sits
 * between two themed scrollbars. */
QAbstractScrollArea::corner {
    background: @surface-panel-raised;
    border: none;
}

/* --- tabs -------------------------------------------------------------------*/

QTabWidget::pane {
    background: @surface-panel;
    border: 1px solid @border-subtle;
    border-radius: 10px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: @text-secondary;
    padding: 8px 12px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: @text-primary;
}

QTabBar::tab:selected {
    color: @text-primary;
    border-bottom-color: @accent;
}

/* --- splitters ----------------------------------------------------------- */
/* A handle with no explicit width/height collapses to almost nothing under a
 * QSS-styled Fusion splitter, which is why these used to be effectively
 * undraggable -- setHandleWidth() in code reserves the space; these rules
 * make that space read as a grabbable hairline rather than a solid bar. */

QSplitter::handle:horizontal {
    width: 6px;
    background: transparent;
    border-left: 1px solid @border-subtle;
}

QSplitter::handle:vertical {
    height: 6px;
    background: transparent;
    border-top: 1px solid @border-subtle;
}

QSplitter::handle:hover {
    border-color: @border-strong;
}

/* --- scrollbars ------------------------------------------------------------*/

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: @scrollbar-thumb;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: @border-strong;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

/* The trough above/below the handle -- QScrollBar:vertical's own background
 * above only covers the groove as a whole; without these two, the page
 * regions specifically fell back to a default (non-transparent) fill. */
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: @scrollbar-thumb;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: @border-strong;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* --- status bar ------------------------------------------------------------*/

QStatusBar {
    background: @surface-panel;
    color: @text-secondary;
    border-top: 1px solid @border-subtle;
}

QStatusBar::item {
    border: none;
}

/* --- dialogs ----------------------------------------------------------------*/

/* All 20 QDialog subclasses (dialogs/*.h, views/CredentialDialog.h) and every
 * QMessageBox/QInputDialog already inherit QWidget/QPushButton/QLineEdit/
 * QCheckBox/QTreeView etc. from the rules above -- qApp->setStyleSheet()
 * (ThemeManager::apply) is application-wide. What was actually missing is a
 * background of their own (QDialog fell through to the Fusion palette,
 * mismatched against the panel surfaces used everywhere else) and the widget
 * vocabulary dialogs lean on that nothing above covers: combo/spin/radio/
 * group boxes, tooltips, progress bars. */
QDialog {
    background: @surface-panel;
}

QMessageBox {
    background: @surface-panel;
}

/* Scoped to inside a dialog, deliberately not a bare `QLabel` rule: the
 * toolbar repo/branch labels, the title-bar app name, and DiffPage's
 * inline-styled stats/empty labels all rely on their own colour and would be
 * overridden by an app-wide QLabel selector. */
QDialog QLabel,
QMessageBox QLabel {
    color: @text-primary;
}

QDialogButtonBox {
    padding-top: 8px;
}

/* --- combo boxes --------------------------------------------------------- */

/* Same box recipe as QLineEdit/QPushButton above, so a combo box reads as
 * part of the same input family instead of a Fusion holdover. */
QComboBox {
    background: @surface-panel;
    color: @text-primary;
    border: 1px solid @border-default;
    border-radius: 6px;
    padding: 0 12px;
    min-height: 30px;
}

QComboBox:hover {
    border-color: @border-strong;
}

QComboBox:focus {
    border: 2px solid @border-focus;
}

QComboBox:disabled {
    color: @text-tertiary;
    background: @surface-sunken;
}

QComboBox::drop-down {
    width: 24px;
    border: none;
}

/* A CSS-triangle arrow rather than an SVG: QSS cannot recolour an image per
 * theme (see the same reasoning on QCheckBox::indicator above), and a solid
 * triangle needs no theme-specific asset at all. */
QComboBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @text-secondary;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background: @surface-overlay;
    color: @text-primary;
    border: 1px solid @border-default;
    border-radius: 6px;
    padding: 4px;
    outline: none;
    selection-background-color: @accent;
    selection-color: @text-on-accent;
}

/* --- spin boxes ------------------------------------------------------------ */

QSpinBox,
QDoubleSpinBox {
    background: @surface-panel;
    color: @text-primary;
    border: 1px solid @border-default;
    border-radius: 6px;
    padding: 0 8px;
    min-height: 30px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 2px solid @border-focus;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    width: 18px;
    border: none;
    background: transparent;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid @text-secondary;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid @text-secondary;
}

/* --- radio buttons ----------------------------------------------------------*/

/* Same size/border recipe as QCheckBox::indicator above, round instead of
 * squared -- the two are meant to read as one family of controls. */
QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border-radius: 8px;
    border: 1.5px solid @border-strong;
    background: @surface-panel;
}

QRadioButton::indicator:hover {
    border-color: @accent;
}

QRadioButton::indicator:checked {
    background: @accent;
    border-color: @accent;
}

QRadioButton::indicator:disabled {
    border-color: @border-subtle;
    background: @surface-sunken;
}

QRadioButton {
    spacing: 8px;
}

/* --- group boxes ------------------------------------------------------------*/

QGroupBox {
    border: 1px solid @border-subtle;
    border-radius: 10px;
    margin-top: 14px;
    padding-top: 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: @text-primary;
}

/* --- tooltips ---------------------------------------------------------------*/

QToolTip {
    background: @surface-overlay;
    color: @text-primary;
    border: 1px solid @border-default;
    border-radius: 4px;
    padding: 4px 8px;
}

/* --- progress bars ------------------------------------------------------------*/

QProgressBar {
    background: @surface-sunken;
    color: @text-primary;
    border: 1px solid @border-subtle;
    border-radius: 6px;
    text-align: center;
    min-height: 16px;
}

QProgressBar::chunk {
    background: @accent;
    border-radius: 5px;
}
